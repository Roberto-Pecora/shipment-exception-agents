{
  "components": {
    "schemas": {
      "Action": {
        "additionalProperties": false,
        "description": "A side effect taken (or requested) while handling a case.",
        "properties": {
          "external_ref": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "External Ref"
          },
          "kind": {
            "enum": [
              "notify",
              "rebook",
              "customs_docs_request",
              "claim",
              "address_confirmation"
            ],
            "title": "Kind",
            "type": "string"
          },
          "params": {
            "additionalProperties": true,
            "title": "Params",
            "type": "object"
          }
        },
        "required": [
          "kind"
        ],
        "title": "Action",
        "type": "object"
      },
      "CaseView": {
        "properties": {
          "actions": {
            "items": {
              "$ref": "#/components/schemas/Action"
            },
            "title": "Actions",
            "type": "array"
          },
          "case_id": {
            "title": "Case Id",
            "type": "string"
          },
          "opened_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Opened At"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "shipment_id": {
            "title": "Shipment Id",
            "type": "string"
          },
          "status": {
            "enum": [
              "open",
              "held"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "shipment_id",
          "case_id",
          "status",
          "reason",
          "opened_at",
          "actions"
        ],
        "title": "CaseView",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "shipex ops-api",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Healthz Healthz Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Healthz"
      }
    },
    "/v1/cases/held": {
      "get": {
        "description": "The ops queue: cases automation handed to a person, oldest first.",
        "operationId": "held_cases_v1_cases_held_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/CaseView"
                  },
                  "title": "Response Held Cases V1 Cases Held Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Held Cases"
      }
    },
    "/v1/cases/{case_id}/release": {
      "post": {
        "description": "Ops has finished with a held case; automation may handle the shipment again.",
        "operationId": "release_v1_cases__case_id__release_post",
        "parameters": [
          {
            "in": "path",
            "name": "case_id",
            "required": true,
            "schema": {
              "title": "Case Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Release"
      }
    },
    "/v1/shipments/{shipment_id}/case": {
      "get": {
        "description": "The open or held case for a shipment, if any.",
        "operationId": "shipment_case_v1_shipments__shipment_id__case_get",
        "parameters": [
          {
            "in": "path",
            "name": "shipment_id",
            "required": true,
            "schema": {
              "title": "Shipment Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CaseView"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Shipment Case"
      }
    }
  }
}
