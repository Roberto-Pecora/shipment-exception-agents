{
  "name": "carrier-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Carrier integration microservice: tracking, rebooking and customs-document APIs with idempotency keys and fault injection.",
  "license": "MIT",
  "type": "commonjs",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node --require ./dist/tracing.js dist/server.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@opentelemetry/exporter-trace-otlp-http": "0.222.0",
    "@opentelemetry/instrumentation-http": "0.222.0",
    "@opentelemetry/sdk-node": "0.222.0",
    "fastify": "5.12.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
