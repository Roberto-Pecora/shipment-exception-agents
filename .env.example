# --- LLM (agent worker) -------------------------------------------------------
# Without a key the agent worker still runs: agent-routed cases escalate to ops.
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Any OpenRouter model with tool calling.
AGENT_MODEL=qwen/qwen3-30b-a3b

# --- Agent budgets: a breach escalates the case --------------------------------
# AGENT_MAX_STEPS=8
# AGENT_MAX_COST_USD=0.05
# AGENT_MAX_WALL_S=90
# AGENT_MAX_INVALID_CALLS=3

# --- Routing policy (deterministic rules) -------------------------------------
# HIGH_VALUE_GBP=10000
# AUTO_CLAIM_LIMIT_GBP=500
# MAX_PLAYBOOK_DELAY_HOURS=24

# --- Guardrails (enforced in code before tools run) ---------------------------
# MAX_REBOOK_COST_DELTA_GBP=150
# MAX_AGENT_CLAIM_GBP=2000

# --- Infrastructure (docker-compose sets these for containers) ----------------
# KAFKA_BOOTSTRAP=localhost:19092
# DATABASE_URL=postgresql://shipex:shipex@localhost:5432/shipex
# CARRIER_GATEWAY_URL=http://localhost:8081
# CONSUMER_MAX_ATTEMPTS=3
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- carrier-gateway fault injection (docker compose) -------------------------
# FAULT_RATE=0.2
# LATENCY_MS=150
